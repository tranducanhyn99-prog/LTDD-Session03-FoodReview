<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/restaurantListFragment">

    <fragment
        android:id="@+id/restaurantListFragment"
        android:name="vn.edu.course.foodreview.RestaurantListFragment"
        android:label="@string/tab_restaurants"
        tools:layout="@layout/fragment_restaurant_list">

        <action
            android:id="@+id/action_list_to_detail"
            app:destination="@id/restaurantDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/favouritesFragment"
        android:name="vn.edu.course.foodreview.FavouritesFragment"
        android:label="@string/tab_favourites"
        tools:layout="@layout/fragment_restaurant_list">

        <action
            android:id="@+id/action_favourites_to_detail"
            app:destination="@id/restaurantDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/restaurantDetailFragment"
        android:name="vn.edu.course.foodreview.RestaurantDetailFragment"
        android:label="@string/detail_title"
        tools:layout="@layout/fragment_restaurant_detail">

        <argument
            android:name="restaurantId"
            app:argType="string" />
    </fragment>

</navigation>
